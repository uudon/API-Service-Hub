    "swagger": "2.0",
    "info": {
        "description": "API Service Hub is a Go-based microservice with health check endpoints.",
        "title": "API Service Hub",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "API Support",
